<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="Web_ConsultorioMedico.MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title><%: Page.Title %>SanaSana - Gestion Clínica</title>


    <!-- CSS principal -->
    <link href="/Styles/main.css" rel="stylesheet" runat="server" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link href="/Styles/FormStyles.css" rel="stylesheet" runat="server" />
<script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="Plantilla" runat="server">
        <div class ="app-container">

          <!-- Sidebar -->
               <!-- Logo y marca -->
                    <aside class ="sidebar">
                        <div class ="sidebar-brand">
                            <div class="brand-logo-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                    <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
                                </svg>
                            </div>
        
                                <div class="brand-text">
                                    <h2 class ="brand-title">SanaSana</h2>
                                    <h4 class ="brand-subtitle">Gestión Clínica</h4>
                                </div>
                        
                        </div>

                 <!-- Descripción del Sidebar -->
                        <h2 class ="descripcion-sidebar"> Espacio de trabajo </h2>
                 <!-- Menú -->
                         <nav class ="sidebar-nav" id="navLegacy" runat="server" visible="false">
                    <!-- Resumen -->
                        <a href="#" class ="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="currentColor">
                                <path d="M15,20V13h7v7H15Zm-4-9V4H22v7H11ZM2,20V13H13v7H2Zm0-9V4H9v7H2ZM13,9h7V6H13V9ZM4,18h7V15H4v3Zm13,0h3V15H17v3ZM4,9H7V6H4V9Zm9,0Zm-2,6Zm6,0ZM7,9Z"/></svg>
                            <span>Resumen</span>
                        </a>
                    <!-- Agenda -->
                        <a href="#" class ="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="currentColor">
                                <path d="M5,22q-0.83,0-1.41-0.59T3,20V6Q3,5.18 3.59,4.59T5,4H6V2H8V4h8V2h2V4h1q0.83,0 1.41,0.59Q21,5.18 21,6V20q0,0.82-0.59,1.41T19,22H5Zm0-2H19V10H5V20ZM5,8H19V6H5V8ZM5,8V6V8Zm7,6q-0.42,0-0.71-0.29Q11,13.43 11,13t0.29-0.71T12,12t0.71,0.29T13,13t-0.29,0.71T12,14ZM7.29,13.71Q7,13.43 7,13t0.29-0.71T8,12t0.71,0.29T9,13T8.71,13.71T8,14q-0.42,0-0.71-0.29ZM16,14q-0.42,0-0.71-0.29Q15,13.43 15,13t0.29-0.71T16,12q0.43,0 0.71,0.29T17,13t-0.29,0.71T16,14Zm-4,4q-0.42,0-0.71-0.29Q11,17.43 11,17t0.29-0.71T12,16t0.71,0.29T13,17t-0.29,0.71T12,18ZM7.29,17.71Q7,17.43 7,17t0.29-0.71T8,16t0.71,0.29T9,17T8.71,17.71T8,18q-0.42,0-0.71-0.29ZM16,18q-0.42,0-0.71-0.29Q15,17.43 15,17t0.29-0.71T16,16q0.43,0 0.71,0.29T17,17t-0.29,0.71T16,18Z"/></svg>
                        <span>Agenda</span>
                        </a>
                    <!-- Pacientes -->    
                        <a href="#" class ="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="currentColor">
                                <path d="M1,20V17.2q0-0.85 0.44-1.56q0.44-0.71 1.16-1.09q1.55-0.78 3.15-1.16T9,13t3.25,0.39t3.15,1.16q0.72,0.38 1.16,1.09T17,17.2V20H1Zm18,0V17q0-1.1-0.61-2.11q-0.61-1.01-1.74-1.74q1.27,0.15 2.4,0.51q1.13,0.36 2.1,0.89q0.9,0.5 1.38,1.11T23,17v3H19ZM6.18,10.83Q5,9.65 5,8T6.18,5.18T9,4t2.83,1.18T13,8t-1.17,2.82T9,12T6.18,10.83Zm11.65,0Q16.65,12 15,12q-0.27,0-0.7-0.06T13.6,11.8q0.67-0.8 1.04-1.78T15,8T14.64,5.97T13.6,4.2q0.35-0.13 0.7-0.16T15,4q1.65,0 2.82,1.18T19,8t-1.18,2.82ZM3,18H15V17.2q0-0.27-0.14-0.5q-0.14-0.22-0.36-0.35q-1.35-0.68-2.72-1.01T9,15T6.23,15.34T3.5,16.35Q3.28,16.48 3.14,16.7Q3,16.93 3,17.2V18Zm7.41-8.59Q11,8.82 11,8T10.41,6.59T9,6Q8.18,6 7.59,6.59Q7,7.18 7,8T7.59,9.41T9,10q0.83,0 1.41-0.59ZM9,18ZM9,8Z"/></svg>
                            <span>Pacientes</span>
                        </a>
                    <!-- Profesionales -->
                        <a href="#" class ="nav-link">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" height="24px" width="24px" fill="currentColor">
                                <path d="M17.35,21L13.8,17.45l1.43-1.4l2.13,2.13l4.25-4.25L23,15.35L17.35,21ZM13.5,22q-2.7,0-4.6-1.9T7,15.5V14.93q-2.15-0.35-3.58-2.01T2,9V3H5V2H7V6H5V5H4V9q0,1.65 1.18,2.82T8,13t2.83-1.18T12,9V5H11V6H9V2h2V3h3V9q0,2.25-1.42,3.91T9,14.93V15.5q0,1.88 1.31,3.19T13.5,20v2Z"/></svg>
                            <span>Profesionales</span>

                        </a>
                       
                </nav>
                        <nav class="sidebar-nav">
                            <asp:Panel ID="pnlAdministracionMenu" runat="server">
                                <%-- <asp:HyperLink runat="server" NavigateUrl="~/ResumenAdministración.aspx" CssClass="nav-link" Text="Resumen" /> --%>
                                <asp:HyperLink runat="server" NavigateUrl="~/GestionMedicos.aspx" CssClass="nav-link" Text="Profesionales" />
                                <asp:HyperLink runat="server" NavigateUrl="~/PacientesLista.aspx" CssClass="nav-link" Text="Pacientes" />
                                <asp:HyperLink runat="server" NavigateUrl="~/Recepcion.aspx" CssClass="nav-link" Text="Agenda General" />
                                <asp:HyperLink runat="server" NavigateUrl="~/Usuarios.aspx" CssClass="nav-link" Text="Usuarios" />
                            </asp:Panel>
                            <asp:Panel ID="pnlMedicoMenu" runat="server" Visible="false">
                                <asp:HyperLink runat="server" NavigateUrl="~/ResumenMedicos.aspx" CssClass="nav-link" Text="Resumen" />
                                <asp:HyperLink runat="server" NavigateUrl="~/Agenda.aspx" CssClass="nav-link" Text="Agenda" />
                            </asp:Panel>
                        </nav>

             <!-- Pie del Sidebar: Usuario ingresado -->
                            <div class="sidebar-footer">
                                <div class="user-profile-card">
                                    <div class="user-avatar">
                                        <asp:Literal ID="litIniciales" runat="server"></asp:Literal>
                                    </div>

                                    <div class="user-info">
                                        <asp:Label ID="lblNombreUsuario" runat="server" CssClass="user-name"></asp:Label>
                                        <asp:Label ID="lblRolUsuario" runat="server" CssClass="user-role"></asp:Label>
                                    </div>

                                    <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="logout-btn" ToolTip="Cerrar sesión" OnClick="btnCerrarSesion_Click">
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                            <polyline points="16 17 21 12 16 7"></polyline>
                                            <line x1="21" y1="12" x2="9" y2="12"></line>
                                        </svg>
                                    </asp:LinkButton>
                                </div>
                            </div>
                </aside>
                        <!-- FIN DE SIDEBAR -->

            <!-- INICIO DE BODY -->
                <!-- (ENCABEZADO Principal) -->
                <div class="main-wrapper">
                
                    <!-- Cabecera Superior + buscador (Tengo que arreglar el top header, etiqueta div sin cierre, pertenece a la clase top header pero si cerro el div, excluye el search box) -->
                    <header>
                        <div class="top-header">
                            <div class ="sitename">
                                <span class="brand-name">SanaSana ›</span> 
                                <asp:Literal ID="litPaginaActual" Text="text" runat="server" />
                            </div>
                        


                    <!-- Buscador -->
                        <div class="search-box">
                            <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                             <circle cx="11" cy="11" r="8"></circle> <line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <input type="text" placeholder="Buscar paciente por nombre o DNI" /></div>
                    </div>
           
                   </header>

           
                <!-- BODY -->
                <main class="content-area">
                    <!-- Encabezado compartido de las páginas -->
                    <div class="page-header-container" id="pageHeaderContainer" runat="server">
                    <div class="page-header-info">
                        <h1 class="page-title"><asp:Literal ID="litPageTitle" runat="server" Text="Encabezado"></asp:Literal></h1>
                        <p class="page-subtitle"><asp:Literal ID="litPageSubtitle" runat="server" Text="Descripción del encabezado"></asp:Literal></p>
                    </div>
                    
                    <div class="page-header-actions">
                        <asp:LinkButton ID="btnSecundario" runat="server" CssClass="btn-secondary" Visible="false">
                            <asp:Literal ID="litBtnSecundario" runat="server"></asp:Literal>
                        </asp:LinkButton>

                        <asp:LinkButton ID="btnPrimario" runat="server" CssClass="btn-primary" Visible="false">
                            <asp:Literal ID="litBtnPrimario" runat="server"></asp:Literal>
                        </asp:LinkButton>
                    </div>
                </div>

                    <!-- Contenido propio de cada página -->
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
                </div>
            </div>
        </form>
</body>
</html>
        
      